      "updated": 1771968683902,
      "link": null,
      "locked": false,
      "text": "Problem 1: Want to swap\nAuthService?\nYou must EDIT LoginComponent\ncode.",
      "fontSize": 14,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "bad_prob1",
      "originalText": "Problem 1: Want to swap AuthService?\nYou must EDIT LoginComponent code.",
