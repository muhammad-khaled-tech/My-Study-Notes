      "boundElements": [],
      "updated": 1771971569755,
      "link": null,
      "locked": false,
      "text": "Angular decides WHAT\nto give it based on\nwhat is registered.\nSwap AuthService for\nMockAuthService in\ntests? Just re-register.",
      "fontSize": 13.804687500000005,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Angular decides WHAT\nto give it based on\nwhat is registered.\nSwap AuthService for\nMockAuthService in\ntests? Just re-register.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
