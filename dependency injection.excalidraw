    },
    {
      "id": "analogy3",
      "type": "text",
      "x": 16.4521484375,
      "y": 365.5390625,
      "width": 940.8499145507812,
      "height": 20,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aF",
      "roundness": null,
      "seed": 1728256325,
      "version": 13,
      "versionNonce": 1168440184,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1771971480272,
      "link": null,
      "locked": false,
      "text": "The GOOD way: your coffee machine has a slot. You INSERT the beans from outside. Espresso today, decaf tomorrow.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The GOOD way: your coffee machine has a slot. You INSERT the beans from outside. Espresso today, decaf tomorrow.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "analogy4",
      "type": "text",
      "x": 17.7900390625,
      "y": 392.0556640625,
      "width": 837.457763671875,
      "height": 20,
      "angle": 0,
      "strokeColor": "#15803d",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aG",
      "roundness": null,
      "seed": 1363790219,
      "version": 14,
      "versionNonce": 923719800,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1771971482256,
      "link": null,
      "locked": false,
      "text": "The machine does NOT care which beans. It just uses whatever you give it. That is Dependency Injection.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The machine does NOT care which beans. It just uses whatever you give it. That is Dependency Injection.",
      "autoResize": true,
      "lineHeight": 1.25
    },
