      "versionNonce": 1190954360,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1771971575206,
      "link": null,
      "locked": false,
      "text": "This is WHY it is a Singleton: Angular creates AuthService ONCE (step 4), then returns that same object every time. Forever.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "This is WHY it is a Singleton: Angular creates AuthService ONCE (step 4), then returns that same object every time. Forever.",
      "autoResize": true,
      "lineHeight": 1.25
    },
