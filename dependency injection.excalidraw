      "isDeleted": false,
      "boundElements": [],
      "updated": 1771971546922,
      "link": null,
      "locked": false,
      "text": "Rule 2: Abstractions should NOT depend on details. Details should depend on abstractions.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "rule2",
      "originalText": "Rule 2: Abstractions should NOT depend on details. Details should depend on abstractions.",
      "autoResize": true,
      "lineHeight": 1.25
    },
