      "fillStyle": "hachure",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "text": "\u26a0 Use = != for STRINGS (not -eq)",
      "fontSize": 11,
      "fontFamily": 2,
