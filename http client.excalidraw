    {
      "id": "8OADD8oaJn89JEvEjJdb4",
      "type": "text",
      "x": 64.18433380126953,
      "y": 688.75,
      "width": 189.63133239746094,
      "height": 112.5,
      "angle": 0,
      "strokeColor": "#16a34a",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
