      "link": null,
      "locked": false,
      "text": "Angular's DI system creates ONE instance and injects it wherever needed -- that is the Singleton pattern.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Angular's DI system creates ONE instance and injects it wherever needed -- that is the Singleton pattern.",
