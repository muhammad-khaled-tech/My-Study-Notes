      "link": null,
      "locked": false,
      "text": "BehaviorSubject\n\ndata$ = new BehaviorSubject()\n\nMultiple subscribers.\nReplays last value.\nOlder but very common\nin real projects.",
      "fontSize": 14,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "p2",
      "originalText": "BehaviorSubject\n\ndata$ = new BehaviorSubject()\n\nMultiple subscribers.\nReplays last value.\nOlder but very common\nin real projects.",
      "autoResize": true,
      "lineHeight": 1.25
    },
