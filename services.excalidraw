      "text": "Plain property\n(no reactivity)\n\nuser: User | null = null\n\nSimple. Works when\ncomponents don't need\nauto-update. Manual\nread only.",
      "fontSize": 14,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "p3",
      "originalText": "Plain property\n(no reactivity)\n\nuser: User | null = null\n\nSimple. Works when\ncomponents don't need\nauto-update. Manual\nread only.",
      "autoResize": true,
      "lineHeight": 1.25
    },
