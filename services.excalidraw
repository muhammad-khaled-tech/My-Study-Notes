    {
      "id": "httpNote",
      "type": "text",
      "x": 30,
      "y": 1093,
      "width": 899.3914794921875,
      "height": 18.75,
      "angle": 0,
      "strokeColor": "#1d4ed8",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "af",
      "roundness": null,
      "seed": 1572552938,
      "version": 2,
      "versionNonce": 1373295094,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1771965275043,
      "link": null,
      "locked": false,
      "text": "NEVER subscribe inside a service unless you have a good reason. Return the Observable raw and let components subscribe.",
      "fontSize": 15,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "NEVER subscribe inside a service unless you have a good reason. Return the Observable raw and let components subscribe.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "httpNote2",
      "type": "text",
      "x": 30,
      "y": 1115,
      "width": 850.6561279296875,
      "height": 18.75,
      "angle": 0,
      "strokeColor": "#555",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "ag",
      "roundness": null,
      "seed": 1598364342,
      "version": 2,
      "versionNonce": 1802236010,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1771965275043,
      "link": null,
      "locked": false,
      "text": "Why? Components control the lifecycle. They know when to unsubscribe (ngOnDestroy) and how to handle UI state.",
      "fontSize": 15,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Why? Components control the lifecycle. They know when to unsubscribe (ngOnDestroy) and how to handle UI state.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "httpNote3",
      "type": "text",
      "x": 30,
      "y": 1137,
      "width": 564.1090087890625,
      "height": 18.75,
      "angle": 0,
      "strokeColor": "#ef4444",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "ah",
      "roundness": null,
      "seed": 2000130986,
      "version": 2,
      "versionNonce": 1171858230,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1771965275043,
      "link": null,
      "locked": false,
      "text": "Exception: effects/stores that manage global state may subscribe internally.",
      "fontSize": 15,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Exception: effects/stores that manage global state may subscribe internally.",
      "autoResize": true,
      "lineHeight": 1.25
    },
