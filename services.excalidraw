      "text": "providedIn: 'root'\n\nSingleton for the WHOLE app.\nOne instance, shared\neverywhere.\nTree-shakeable if unused.",
      "fontSize": 15,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "sc1",
      "originalText": "providedIn: 'root'\n\nSingleton for the WHOLE app.\nOne instance, shared everywhere.\nTree-shakeable if unused.",
      "autoResize": true,
      "lineHeight": 1.25
    },
