0.20389885,-0.07633298,0.08664622,0.00207638,-0.00422993,0.02209308,0.04495309,0.01817475,0.00205773,0.00284916,0.09994825,-0.03821058,-0.00521544,-0.02268312,-0.00228686,0.01414937,0.03952106,-0.0109535,-0.01838206,0.0118948,-0.03534441,0.04406311,0.07962846,0.01434357,0.0164838,-0.0996193,-0.04641308,-0.03611156,-0.02431359,0.00012391,-0.00188757,0.00632406,0.05467287,0.06285397,0.00852805,-0.00075993,-0.03889346,0.01964159,0.0187076,-0.07851465,0.07756541,0.0644724,-0.02602003],"last_embed":{"hash":"pnu2h6","tokens":439}}},"last_read":{"hash":"pnu2h6","at":1783126417833},"class_name":"SmartSource","last_import":{"mtime":1783126397279,"size":92840,"at":1783126408649,"hash":"pnu2h6"},"blocks":{"#---frontmatter---":[1,5],"#🐍 بايثون من الصفر — الأساسيات (Q1 → نهاية الملف)":[7,130],"#🐍 بايثون من الصفر — الأساسيات (Q1 → نهاية الملف)#{1}":[9,13],"#🐍 بايثون من الصفر — الأساسيات (Q1 → نهاية الملف)#Q1 — إيه الـ Variable في بايثون وإزاي بايثون بتشوف \"الاسم\" و\"الـ object\" كحاجتين مختلفتين؟":[14,77],"#🐍 بايثون من الصفر — الأساسيات (Q1 → نهاية الملف)#Q1 — إيه الـ Variable في بايثون وإزاي بايثون بتشوف \"الاسم\" و\"الـ object\" كحاجتين مختلفتين؟#أصل الحكاية":[16,65],"#🐍 بايثون من الصفر — الأساسيات (Q1 → نهاية الملف)#Q1 — إيه الـ Variable في بايثون وإزاي بايثون بتشوف \"الاسم\" و\"الـ object\" كحاجتين مختلفتين؟#أصل الحكاية#{1}":[17,65],"#🐍 بايثون من الصفر — الأساسيات (Q1 → نهاية الملف)#Q1 — إيه الـ Variable في بايثون وإزاي بايثون بتشوف \"الاسم\" و\"الـ object\" كحاجتين مختلفتين؟#الفايدة الانترفيوية":[66,77],"#🐍 بايثون من الصفر — الأساسيات (Q1 → نهاية الملف)#Q1 — إيه الـ Variable في بايثون وإزاي بايثون بتشوف \"الاسم\" و\"الـ object\" كحاجتين مختلفتين؟#الفايدة الانترفيوية#{1}":[67,77],"#🐍 بايثون من الصفر — الأساسيات (Q1 → نهاية الملف)#Q2 — إيه قواعد التسمية الإجبارية وإيه الـ PEP 8 conventions المتعارف عليها؟":[78,130],"#🐍 بايثون من الصفر — الأساسيات (Q1 → نهاية الملف)#Q2 — إيه قواعد التسمية الإجبارية وإيه الـ PEP 8 conventions المتعارف عليها؟#أصل الحكاية":[80,124],"#🐍 بايثون من الصفر — الأساسيات (Q1 → نهاية الملف)#Q2 — إيه قواعد التسمية الإجبارية وإيه الـ PEP 8 conventions المتعارف عليها؟#أصل الحكاية#{1}":[81,124],"#🐍 بايثون من الصفر — الأساسيات (Q1 → نهاية الملف)#Q2 — إيه قواعد التسمية الإجبارية وإيه الـ PEP 8 conventions المتعارف عليها؟#الفايدة الانترفيوية":[125,130],"#🐍 بايثون من الصفر — الأساسيات (Q1 → نهاية الملف)#Q2 — إيه قواعد التسمية الإجبارية وإيه الـ PEP 8 conventions المتعارف عليها؟#الفايدة الانترفيوية#{1}":[126,130],"#Using camelCase for variables is legal but bad style":[131,146],"#Using camelCase for variables is legal but bad style#{1}":[132,146],"#Dynamic typing: the variable 'x' changes type based on the object assigned":[147,160],"#Dynamic typing: the variable 'x' changes type based on the object assigned#{1}":[148,160],"#This function accepts any type, Python checks methods at runtime":[161,169],"#This function accepts any type, Python checks methods at runtime#{1}":[162,169],"#Python doesn't care about the type, only if it has the required method":[170,177],"#Python doesn't care about the type, only if it has the required method#{1}":[171,177],"#We don't check the type, we just call .speak()":[178,186],"#We don't check the type, we just call .speak()#{1}":[179,186],"#Python 3+ Type hints: they don't enforce types at runtime, but help linters":[187,190],"#Python 3+ Type hints: they don't enforce types at runtime, but help linters#{1}":[188,190],"#This will run fine at runtime, despite the hint!":[191,192],"#This will run fine at runtime, despite the hint!#{1}":[192,192],"#TypeError happens later if we try to add int and str, but the call itself doesn't fail immediately":[193,206],"#TypeError happens later if we try to add int and str, but the call itself doesn't fail immediately#{1}":[194,206],"#Dynamic typing معناها النوع بيتحدد وقت التشغيل بناءً على القيمة، والاسم ممكن يشاور على أنواع مختلفة في أوقات مختلفة.":[207,275],"#Dynamic typing معناها النوع بيتحدد وقت التشغيل بناءً على القيمة، والاسم ممكن يشاور على أنواع مختلفة في أوقات مختلفة.#{1}":[209,210],"#Dynamic typing معناها النوع بيتحدد وقت التشغيل بناءً على القيمة، والاسم ممكن يشاور على أنواع مختلفة في أوقات مختلفة.#Q4 — إيه الفرق الحقيقي بين `is` و`==`؟ (Small Integer Cache وString Interning)":[211,275],"#Dynamic typing معناها النوع بيتحدد وقت التشغيل بناءً على القيمة، والاسم ممكن يشاور على أنواع مختلفة في أوقات مختلفة.#Q4 — إيه الفرق الحقيقي بين `is` و`==`؟ (Small Integer Cache وString Interning)#أصل الحكاية":[213,270],"#Dynamic typing معناها النوع بيتحدد وقت التشغيل بناءً على القيمة، والاسم ممكن يشاور على أنواع مختلفة في أوقات مختلفة.#Q4 — إيه الفرق الحقيقي بين `is` و`==`؟ (Small Integer Cache وString Interning)#أصل الحكاية#{1}":[214,270],"#Dynamic typing معناها النوع بيتحدد وقت التشغيل بناءً على القيمة، والاسم ممكن يشاور على أنواع مختلفة في أوقات مختلفة.#Q4 — إيه الفرق الحقيقي بين `is` و`==`؟ (Small Integer Cache وString Interning)#الفايدة الانترفيوية":[271,275],"#Dynamic typing معناها النوع بيتحدد وقت التشغيل بناءً على القيمة، والاسم ممكن يشاور على أنواع مختلفة في أوقات مختلفة.#Q4 — إيه الفرق الحقيقي بين `is` و`==`؟ (Small Integer Cache وString Interning)#الفايدة الانترفيوية#{1}":[272,275],"#Never rely on caching for your logic!":[276,276],"#Just because `x is y` is True for 256 doesn't mean it's safe to use 'is' for integer comparison.":[277,356],"#Just because `x is y` is True for 256 doesn't mean it's safe to use 'is' for integer comparison.#{1}":[278,296],"#Just because `x is y` is True for 256 doesn't mean it's safe to use 'is' for integer comparison.#Q5 — إيه معنى Mutable وImmutable وليه ده مهم؟ (مع الـ default mutable argument trap)":[297,356],"#Just because `x is y` is True for 256 doesn't mean it's safe to use 'is' for integer comparison.#Q5 — إيه معنى Mutable وImmutable وليه ده مهم؟ (مع الـ default mutable argument trap)#أصل الحكاية":[299,351],"#Just because `x is y` is True for 256 doesn't mean it's safe to use 'is' for integer comparison.#Q5 — إيه معنى Mutable وImmutable وليه ده مهم؟ (مع الـ default mutable argument trap)#أصل الحكاية#{1}":[300,351],"#Just because `x is y` is True for 256 doesn't mean it's safe to use 'is' for integer comparison.#Q5 — إيه معنى Mutable وImmutable وليه ده مهم؟ (مع الـ default mutable argument trap)#الفايدة الانترفيوية":[352,356],"#Just because `x is y` is True for 256 doesn't mean it's safe to use 'is' for integer comparison.#Q5 — إيه معنى Mutable وImmutable وليه ده مهم؟ (مع الـ default mutable argument trap)#الفايدة الانترفيوية#{1}":[353,356],"#Immutable: int, float, str, tuple, bool. (Any change makes a new object).":[357,357],"#Mutable: list, dict, set. (Changes happen in place).":[358,358],"#Default args are evaluated at function definition time, not call time.":[359,361],"#Default args are evaluated at function definition time, not call time.#{1}":[361,361],"#Thinking a tuple with a list inside is completely immutable.":[362,364],"#Thinking a tuple with a list inside is completely immutable.#{1}":[363,364],"#(Because += on a list modifies in place, then tuple tries to reassign the item and fails)":[365,379],"#(Because += on a list modifies in place, then tuple tries to reassign the item and fails)#{1}":[366,379],"#sys.getrefcount(a) returns the count. Note: passing 'a' as an argument adds 1 temporarily!":[380,398],"#sys.getrefcount(a) returns the count. Note: passing 'a' as an argument adds 1 temporarily!#{1}":[381,398],"#The list object has a refcount of 1 (from 'x')":[399,400],"#The list object has a refcount of 1 (from 'x')#{1}":[400,400],"#refcount is 2":[401,402],"#refcount is 2#{1}":[402,402],"#refcount is 1 (only 'y' remains)":[403,404],"#refcount is 1 (only 'y' remains)#{1}":[404,404],"#refcount is 0 -> Python immediately deallocates the list from memory":[405,411],"#refcount is 0 -> Python immediately deallocates the list from memory#{1}":[406,411],"#We disable GC to see the effect manually":[412,422],"#We disable GC to see the effect manually#{1}":[413,422],"#Even though we deleted the names, the objects still reference each other.":[423,423],"#Reference count is NOT zero. Memory leak!":[424,424],"#The GC (when enabled) specifically looks for these cycles to clean them up.":[425,426],"#The GC (when enabled) specifically looks for these cycles to clean them up.#{1}":[426,426],"#GC will eventually find and collect these unreachable cycles.":[427,442],"#GC will eventually find and collect these unreachable cycles.#{1}":[428,442],"#Create a cycle and remove outer references":[443,446],"#Create a cycle and remove outer references#{1}":[444,446],"#Force garbage collection":[447,449],"#Force garbage collection#{1}":[448,449],"#Output will show \"MyObject is being destroyed!\" twice":[450,462],"#Output will show \"MyObject is being destroyed!\" twice#{1}":[451,462],"#Reference counting is immediate. GC is for circular references.":[463,463],"#You don't usually manage memory manually in Python, but knowing this explains unexpected object lifetimes.":[464,542],"#You don't usually manage memory manually in Python, but knowing this explains unexpected object lifetimes.#{1}":[466,467],"#You don't usually manage memory manually in Python, but knowing this explains unexpected object lifetimes.#Q7 — إيه الـ Shallow Copy والـ Deep Copy وإمتى تستخدم كل واحدة؟":[468,542],"#You don't usually manage memory manually in Python, but knowing this explains unexpected object lifetimes.#Q7 — إيه الـ Shallow Copy والـ Deep Copy وإمتى تستخدم كل واحدة؟#أصل الحكاية":[470,537],"#You don't usually manage memory manually in Python, but knowing this explains unexpected object lifetimes.#Q7 — إيه الـ Shallow Copy والـ Deep Copy وإمتى تستخدم كل واحدة؟#أصل الحكاية#{1}":[471,537],"#You don't usually manage memory manually in Python, but knowing this explains unexpected object lifetimes.#Q7 — إيه الـ Shallow Copy والـ Deep Copy وإمتى تستخدم كل واحدة؟#الفايدة الانترفيوية":[538,542],"#You don't usually manage memory manually in Python, but knowing this explains unexpected object lifetimes.#Q7 — إيه الـ Shallow Copy والـ Deep Copy وإمتى تستخدم كل واحدة؟#الفايدة الانترفيوية#{1}":[539,542],"#Assuming `list.copy()` or `list[:]` makes your nested lists independent.":[543,543],"#It only copies the top level. If you have mutables inside mutables, changes will leak!":[544,626],"#It only copies the top level. If you have mutables inside mutables, changes will leak!#{1}":[545,558],"#It only copies the top level. If you have mutables inside mutables, changes will leak!#Q8 — إيه الـ LEGB Rule وإزاي بايثون بتدور على أي اسم؟ (`global` وـ`nonlocal`)":[559,626],"#It only copies the top level. If you have mutables inside mutables, changes will leak!#Q8 — إيه الـ LEGB Rule وإزاي بايثون بتدور على أي اسم؟ (`global` وـ`nonlocal`)#أصل الحكاية":[561,621],"#It only copies the top level. If you have mutables inside mutables, changes will leak!#Q8 — إيه الـ LEGB Rule وإزاي بايثون بتدور على أي اسم؟ (`global` وـ`nonlocal`)#أصل الحكاية#{1}":[562,621],"#It only copies the top level. If you have mutables inside mutables, changes will leak!#Q8 — إيه الـ LEGB Rule وإزاي بايثون بتدور على أي اسم؟ (`global` وـ`nonlocal`)#الفايدة الانترفيوية":[622,626],"#It only copies the top level. If you have mutables inside mutables, changes will leak!#Q8 — إيه الـ LEGB Rule وإزاي بايثون بتدور على أي اسم؟ (`global` وـ`nonlocal`)#الفايدة الانترفيوية#{1}":[623,626],"#Trying to modify a global without the 'global' keyword":[627,700],"#Trying to modify a global without the 'global' keyword#{1}":[628,640],"#Trying to modify a global without the 'global' keyword#Q9 — إيه الـ `del` statement وبيحذف الـ object فعلاً ولا بس الاسم؟":[641,700],"#Trying to modify a global without the 'global' keyword#Q9 — إيه الـ `del` statement وبيحذف الـ object فعلاً ولا بس الاسم؟#أصل الحكاية":[643,695],"#Trying to modify a global without the 'global' keyword#Q9 — إيه الـ `del` statement وبيحذف الـ object فعلاً ولا بس الاسم؟#أصل الحكاية#{1}":[644,695],"#Trying to modify a global without the 'global' keyword#Q9 — إيه الـ `del` statement وبيحذف الـ object فعلاً ولا بس الاسم؟#الفايدة الانترفيوية":[696,700],"#Trying to modify a global without the 'global' keyword#Q9 — إيه الـ `del` statement وبيحذف الـ object فعلاً ولا بس الاسم؟#الفايدة الانترفيوية#{1}":[697,700],"#`del` removes the binding (name), not necessarily the object.":[701,701],"#It can also delete items from lists/keys from dicts.":[702,718],"#It can also delete items from lists/keys from dicts.#{1}":[703,718],"#Pre-declare the allowed attributes":[719,728],"#Pre-declare the allowed attributes#{1}":[720,728],"#Without slots, you can add new attributes dynamically":[729,731],"#Without slots, you can add new attributes dynamically#{1}":[730,731],"#With slots, you CANNOT add new attributes":[732,732],"#obj2.z = 3 -> AttributeError: 'WithSlots' object has no attribute 'z'":[733,742],"#obj2.z = 3 -> AttributeError: 'WithSlots' object has no attribute 'z'#{1}":[734,742],"#Notice the size difference (this doesn't count the dicts themselves, but shows structural savings)":[743,753],"#Notice the size difference (this doesn't count the dicts themselves, but shows structural savings)#{1}":[744,753],"#If Child doesn't define __slots__, it gets a __dict__ anyway!":[754,759],"#If Child doesn't define __slots__, it gets a __dict__ anyway!#{1}":[755,759],"#c.z = 3 -> AttributeError":[760,764],"#c.z = 3 -> AttributeError#{1}":[761,764],"#A realistic use case: processing millions of records where memory is tight":[765,772],"#A realistic use case: processing millions of records where memory is tight#{1}":[766,772],"#Creating 1 million points will use significantly less RAM than without __slots__":[773,787],"#Creating 1 million points will use significantly less RAM than without __slots__#{1}":[774,787],"#__slots__ saves memory by preventing the creation of __dict__.":[788,788],"#It restricts attribute creation to only those listed.":[789,789],"#Good for millions of objects, bad for dynamic/flexible classes.":[790,800],"#Good for millions of objects, bad for dynamic/flexible classes.#{1}":[791,800],"#Numeric types":[801,805],"#Numeric types#{1}":[802,805],"#Text type":[806,808],"#Text type#{1}":[807,808],"#Sequence types (Ordered)":[809,813],"#Sequence types (Ordered)#{1}":[810,813],"#Set types (Unordered, Unique)":[814,817],"#Set types (Unordered, Unique)#{1}":[815,817],"#Mapping type (Key-Value)":[818,820],"#Mapping type (Key-Value)#{1}":[819,820],"#Boolean and None types":[821,827],"#Boolean and None types#{1}":[822,827],"#Lists are mutable":[828,832],"#Lists are mutable#{1}":[829,832],"#Tuples are immutable":[833,834],"#Tuples are immutable#{1}":[834,834],"#my_tuple[0] = 99 -> TypeError: 'tuple' object does not support item assignment":[835,839],"#my_tuple[0] = 99 -> TypeError: 'tuple' object does not support item assignment#{1}":[836,839],"#All empty built-in collections evaluate to False":[840,851],"#All empty built-in collections evaluate to False#{1}":[841,851],"#Need unique items and fast lookup? Use set.":[852,854],"#Need unique items and fast lookup? Use set.#{1}":[853,854],"#Need key-value mapping? Use dict.":[855,857],"#Need key-value mapping? Use dict.#{1}":[856,857],"#Need a fixed record that shouldn't change? Use tuple.":[858,860],"#Need a fixed record that shouldn't change? Use tuple.#{1}":[859,860],"#Need an ordered, changeable list? Use list.":[861,931],"#Need an ordered, changeable list? Use list.#{1}":[862,875],"#Need an ordered, changeable list? Use list.#Q12 — إيه الـ int في بايثون وليه مفيش integer overflow؟ (arbitrary precision)":[876,931],"#Need an ordered, changeable list? Use list.#Q12 — إيه الـ int في بايثون وليه مفيش integer overflow؟ (arbitrary precision)#أصل الحكاية":[878,926],"#Need an ordered, changeable list? Use list.#Q12 — إيه الـ int في بايثون وليه مفيش integer overflow؟ (arbitrary precision)#أصل الحكاية#{1}":[879,926],"#Need an ordered, changeable list? Use list.#Q12 — إيه الـ int في بايثون وليه مفيش integer overflow؟ (arbitrary precision)#الفايدة الانترفيوية":[927,931],"#Need an ordered, changeable list? Use list.#Q12 — إيه الـ int في بايثون وليه مفيش integer overflow؟ (arbitrary precision)#الفايدة الانترفيوية#{1}":[928,931],"#Just because Python handles huge ints natively doesn't mean it's fast.":[932,932],"#Arithmetic on very large integers is slower than on small ones (which fit into a single CPU register).":[933,933],"#For heavy numerical computing, numpy (which uses C-types) is preferred.":[934,993],"#For heavy numerical computing, numpy (which uses C-types) is preferred.#{1}":[935,944],"#For heavy numerical computing, numpy (which uses C-types) is preferred.#Q13 — إيه الـ float وليه `0.1 + 0.2 != 0.3`؟ (IEEE 754 floating point)":[945,993],"#For heavy numerical computing, numpy (which uses C-types) is preferred.#Q13 — إيه الـ float وليه `0.1 + 0.2 != 0.3`؟ (IEEE 754 floating point)#أصل الحكاية":[947,988],"#For heavy numerical computing, numpy (which uses C-types) is preferred.#Q13 — إيه الـ float وليه `0.1 + 0.2 != 0.3`؟ (IEEE 754 floating point)#أصل الحكاية#{1}":[948,988],"#For heavy numerical computing, numpy (which uses C-types) is preferred.#Q13 — إيه الـ float وليه `0.1 + 0.2 != 0.3`؟ (IEEE 754 floating point)#الفايدة الانترفيوية":[989,993],"#For heavy numerical computing, numpy (which uses C-types) is preferred.#Q13 — إيه الـ float وليه `0.1 + 0.2 != 0.3`؟ (IEEE 754 floating point)#الفايدة الانترفيوية#{1}":[990,993],"#Using floats for financial systems.":[994,994],"#$0.01 errors can accumulate over millions of transactions to huge losses.":[995,995],"#Use `decimal.Decimal` instead for exact decimal arithmetic.":[996,1066],"#Use `decimal.Decimal` instead for exact decimal arithmetic.#{1}":[997,1006],"#Use `decimal.Decimal` instead for exact decimal arithmetic.#Q14 — إزاي تقارن أرقام float بشكل آمن؟ (`math.isclose()` بدل `==`)":[1007,1066],"#Use `decimal.Decimal` instead for exact decimal arithmetic.#Q14 — إزاي تقارن أرقام float بشكل آمن؟ (`math.isclose()` بدل `==`)#أصل الحكاية":[1009,1061],"#Use `decimal.Decimal` instead for exact decimal arithmetic.#Q14 — إزاي ت