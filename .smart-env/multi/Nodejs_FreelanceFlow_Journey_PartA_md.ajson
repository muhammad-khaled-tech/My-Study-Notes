:[1977,2148],"#🔐 Sprint 4 — Password Hashing : ليه الـ Password Plain Text خطر جداً؟#شرح كل سطر في الـ Hook — بالتفصيل الكامل#`userSchema.pre('save', async function(next) { ... })`":[1979,2004],"#🔐 Sprint 4 — Password Hashing : ليه الـ Password Plain Text خطر جداً؟#شرح كل سطر في الـ Hook — بالتفصيل الكامل#`userSchema.pre('save', async function(next) { ... })`#{1}":[1981,2004],"#🔐 Sprint 4 — Password Hashing : ليه الـ Password Plain Text خطر جداً؟#شرح كل سطر في الـ Hook — بالتفصيل الكامل#`this` — إيه ده بالظبط؟":[2005,2035],"#🔐 Sprint 4 — Password Hashing : ليه الـ Password Plain Text خطر جداً؟#شرح كل سطر في الـ Hook — بالتفصيل الكامل#`this` — إيه ده بالظبط؟#{1}":[2007,2035],"#🔐 Sprint 4 — Password Hashing : ليه الـ Password Plain Text خطر جداً؟#شرح كل سطر في الـ Hook — بالتفصيل الكامل#`if (!this.isModified('password')) return next();`":[2036,2072],"#🔐 Sprint 4 — Password Hashing : ليه الـ Password Plain Text خطر جداً؟#شرح كل سطر في الـ Hook — بالتفصيل الكامل#`if (!this.isModified('password')) return next();`#{1}":[2038,2072],"#🔐 Sprint 4 — Password Hashing : ليه الـ Password Plain Text خطر جداً؟#شرح كل سطر في الـ Hook — بالتفصيل الكامل#`this.password = await bcrypt.hash(this.password, 12);`":[2073,2100],"#🔐 Sprint 4 — Password Hashing : ليه الـ Password Plain Text خطر جداً؟#شرح كل سطر في الـ Hook — بالتفصيل الكامل#`this.password = await bcrypt.hash(this.password, 12);`#{1}":[2075,2076],"#🔐 Sprint 4 — Password Hashing : ليه الـ Password Plain Text خطر جداً؟#شرح كل سطر في الـ Hook — بالتفصيل الكامل#`this.password = await bcrypt.hash(this.password, 12);`#{2}":[2077,2077],"#🔐 Sprint 4 — Password Hashing : ليه الـ Password Plain Text خطر جداً؟#شرح كل سطر في الـ Hook — بالتفصيل الكامل#`this.password = await bcrypt.hash(this.password, 12);`#{3}":[2078,2090],"#🔐 Sprint 4 — Password Hashing : ليه الـ Password Plain Text خطر جداً؟#شرح كل سطر في الـ Hook — بالتفصيل الكامل#`this.password = await bcrypt.hash(this.password, 12);`#{4}":[2080,2090],"#🔐 Sprint 4 — Password Hashing : ليه الـ Password Plain Text خطر جداً؟#شرح كل سطر في الـ Hook — بالتفصيل الكامل#`this.password = await bcrypt.hash(this.password, 12);`#{5}":[2091,2091],"#🔐 Sprint 4 — Password Hashing : ليه الـ Password Plain Text خطر جداً؟#شرح كل سطر في الـ Hook — بالتفصيل الكامل#`this.password = await bcrypt.hash(this.password, 12);`#{6}":[2092,2092],"#🔐 Sprint 4 — Password Hashing : ليه الـ Password Plain Text خطر جداً؟#شرح كل سطر في الـ Hook — بالتفصيل الكامل#`this.password = await bcrypt.hash(this.password, 12);`#{7}":[2093,2094],"#🔐 Sprint 4 — Password Hashing : ليه الـ Password Plain Text خطر جداً؟#شرح كل سطر في الـ Hook — بالتفصيل الكامل#`this.password = await bcrypt.hash(this.password, 12);`#{8}":[2095,2100],"#🔐 Sprint 4 — Password Hashing : ليه الـ Password Plain Text خطر جداً؟#شرح كل سطر في الـ Hook — بالتفصيل الكامل#`select: false` على الـ password field":[2101,2134],"#🔐 Sprint 4 — Password Hashing : ليه الـ Password Plain Text خطر جداً؟#شرح كل سطر في الـ Hook — بالتفصيل الكامل#`select: false` على الـ password field#{1}":[2103,2134],"#🔐 Sprint 4 — Password Hashing : ليه الـ Password Plain Text خطر جداً؟#شرح كل سطر في الـ Hook — بالتفصيل الكامل#`next()` — ليه في آخر الـ Hook؟":[2135,2148],"#🔐 Sprint 4 — Password Hashing : ليه الـ Password Plain Text خطر جداً؟#شرح كل سطر في الـ Hook — بالتفصيل الكامل#`next()` — ليه في آخر الـ Hook؟#{1}":[2137,2148],"#🔐 Sprint 4 — Password Hashing : ليه الـ Password Plain Text خطر جداً؟#✅ Checkpoint":[2149,2197],"#🔐 Sprint 4 — Password Hashing : ليه الـ Password Plain Text خطر جداً؟#✅ Checkpoint#{1}":[2151,2197],"#🔐 Sprint 4 — Password Hashing : ليه الـ Password Plain Text خطر جداً؟#ملخص Sprint 4":[2198,2220],"#🔐 Sprint 4 — Password Hashing : ليه الـ Password Plain Text خطر جداً؟#ملخص Sprint 4#{1}":[2200,2201],"#🔐 Sprint 4 — Password Hashing : ليه الـ Password Plain Text خطر جداً؟#ملخص Sprint 4#{2}":[2202,2202],"#🔐 Sprint 4 — Password Hashing : ليه الـ Password Plain Text خطر جداً؟#ملخص Sprint 4#{3}":[2203,2203],"#🔐 Sprint 4 — Password Has